# CMake build directories. Both underscore and hyphen variants are
# ignored (Ilia/Amelia review finding on tasks 0012/0013: ad-hoc build
# dirs like `build-shuosher/`/`build-ilia/` used only an underscore
# pattern previously and showed up as untracked cruft).
build/
build_*/
build-*/
cmake-build-*/

# Editor/OS cruft
.DS_Store
*.swp

# Ad-hoc local benchmark reruns. Accepted reference baselines are committed
# explicitly (see BENCHMARKS.md #10) rather than ignored wholesale.
benchmarks/results/*.local.csv

# Generated VTK visualization output (tutorials/scalar_advection_3d_visualization/) --
# regenerated by running the tutorial, not committed.
vtk_output/

# Local Python virtual environments (tutorials/burgers_1d_shock_and_steepening/,
# tutorials/burgers_2d_diagonal_shock/ -- their READMEs suggest creating one
# to install numpy/pandas/matplotlib, but it must never be committed).
.venv/
__pycache__/

# Raw per-snapshot tutorial/verification field data (VTK frames), repo-wide
# (docs/adr/0013-tutorial-data-commit-policy.md): every tutorial commits only
# figures/*.png and data/**/summary.csv (plus other small derived-metric
# CSVs), never raw per-snapshot field dumps -- regenerated by re-running the
# tutorial. Generalized from this rule's original two forward-step-specific
# lines (tutorials/euler_2d_forward_step/, tutorials/euler_3d_forward_step_extrusion/,
# task 0010) to one repo-wide pattern so a future tutorial does not need its
# own addition here. Does not ignore the whole data/ directory -- summary.csv
# and other CSVs must stay trackable. Historical VTK frames already committed
# in prior commits are a separate cleanup question the ADR explicitly leaves
# open, not addressed by this ignore rule (git does not retroactively untrack
# already-committed files).
tutorials/*/data/**/*.vtk
